{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["custom/lang", "pulseaudio", "backlight", "battery", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "  {}"
    },

    "clock": {
        "format": "{:%Y-%m-%d  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    // "sway/language": {
    // "format": "\uf11c  {short}",
    // "tooltip-format": "{long}",
    // "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    // },
    "custom/lang": {
        "exec": "swaymsg -t get_inputs -r | grep -m1 -o '\"xkb_active_layout_name\": \"[^\"]*\"' | cut -d'\"' -f4 | sed 's/English (US)/us/;s/Uzbek (Latin)/uz/;s/Russian/ru/'",
        "interval": 1,
        "format": "\uf11c  {}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "network": {
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-ethernet": "  {ipaddr}",
        "format-disconnected": "  Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "nm-connection-editor"
    },

"pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "\uf6a9  Muted",
    "format-icons": {
        "default": ["\uf026", "\uf027", "\uf028"]
    },
    "on-click": "pavucontrol"
},

"backlight": {
    "format": "\uf185  {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
},

"battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "\uf0e7  {capacity}%",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "states": {
        "warning": 30,
        "critical": 15
    }
},

    "tray": {
        "spacing": 8
    }
}
